{
  "$id": "molt://sports/schema/event/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access_tier": {
      "enum": [
        "PUBLIC",
        "MEDIA",
        "BOOK",
        "REGULATOR",
        "REVIEWER"
      ]
    },
    "actor": {
      "pattern": "^did:key:[A-Za-z0-9]+$",
      "type": "string"
    },
    "event_id": {
      "pattern": "^blake3:[0-9a-f]{64}$",
      "type": "string"
    },
    "kind": {
      "pattern": "^(WORLD|IDENTITY|INGEST|CLAIM|EVIDENCE|CHALLENGE|VERDICT|ATTEST|QUARANTINE)\\.[A-Z_]+$",
      "type": "string"
    },
    "model_versions": {
      "items": {
        "properties": {
          "byok_tenant": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "params_hash": {
            "pattern": "^blake3:[0-9a-f]{64}$",
            "type": "string"
          },
          "prompt_hash": {
            "pattern": "^blake3:[0-9a-f]{64}$",
            "type": "string"
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model",
          "prompt_hash",
          "params_hash"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "payload": {
      "type": "object"
    },
    "prev": {
      "pattern": "^(blake3:[0-9a-f]{64}|GENESIS)$",
      "type": "string"
    },
    "refs": {
      "items": {
        "pattern": "^blake3:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array"
    },
    "role": {
      "enum": [
        "ENGINE",
        "OPERATOR",
        "REVIEWER",
        "PUBLIC"
      ]
    },
    "sig": {
      "pattern": "^ed25519:[A-Za-z0-9+/=]+$",
      "type": "string"
    },
    "stream": {
      "pattern": "^sports/[a-z0-9]+/[0-9]{4}-[0-9]{2}/(game|season|lottery|market)/[A-Z0-9-]+$",
      "type": "string"
    },
    "ts_utc": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "prev",
    "stream",
    "kind",
    "actor",
    "role",
    "ts_utc",
    "payload",
    "refs",
    "sig"
  ],
  "type": "object"
}